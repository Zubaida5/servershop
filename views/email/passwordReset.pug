extends baseEmail
block content
  p Hi #{firstName},
  p You requested to reset your password. Use the code below to reset it:
  table(role='presentation', border='0', cellpadding='0', cellspacing='0', align='center')
    tbody
      tr
        td(align='center', style='padding: 20px 0;')
          span(style='font-size: 32px; font-weight: bold; letter-spacing: 8px; color: #333;')= otp
  p This code is valid for 10 minutes.
  p If you didn't forget your password, please ignore this email!